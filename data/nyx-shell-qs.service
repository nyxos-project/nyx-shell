[Unit]
Description=Nyx Shell surfaces (Quickshell)
Documentation=https://github.com/nyxos-project/nyx-shell
After=graphical-session.target nyx-shell-core.service
Wants=nyx-shell-core.service
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5
# Quickshell aborts without a display.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/qs --path %h/.local/share/nyx-shell/qml/shell.qml --no-duplicate
Environment=QML_IMPORT_PATH=%h/.local/share/nyx-shell/qml
Environment=QS_NO_RELOAD_POPUP=1
# systemd restarts it; no crash window over the desktop.
Environment=QS_DISABLE_CRASH_HANDLER=1
# Hyprland closes its request socket after every answer; Quickshell would log each one.
Environment=QT_LOGGING_RULES=quickshell.io.socket.warning=false;qt.svg.warning=false
Environment=NYX_SHELL_MODE=core
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
