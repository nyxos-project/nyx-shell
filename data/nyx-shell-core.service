[Unit]
Description=Nyx Shell Core
Documentation=https://github.com/nyxos-project/nyx-shell
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
ExecStart=%h/.local/bin/nyx-shell-core
# A clean exit (a quit request, the compositor's socket closing) brings it back too;
# the start limit still ends a crash loop and OnFailure reports it.
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
