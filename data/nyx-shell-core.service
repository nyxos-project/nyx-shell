[Unit]
Description=Nyx Shell Core
Documentation=https://github.com/nyxos-project/nyx-shell
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
ExecStart=%h/.local/bin/nyx-shell-core
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
